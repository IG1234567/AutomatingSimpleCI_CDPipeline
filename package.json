{
  "name": "corpx-knowledge-base",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal test knowledge base (11ty)",
  "scripts": {
    "eleventy:prod": "eleventy",
    "prod": "npm run eleventy:prod",
    "lint:js": "eslint --no-ignore .eleventy.js script",
    "lint:all": "npm run lint:js",
    "workspace:dev": "eleventy --pathprefix=/_site/ && http-server ./ -c-1 -o /_site/"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "eslint": "^8.57.0",
    "http-server": "^14.1.1"
  }
}
